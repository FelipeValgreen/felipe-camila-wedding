# Centro de Gestión — variables de ejemplo
# Nunca guardar valores reales en Git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_STAGING_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CRON_SECRET=

# Copiloto IA
# En Vercel puede autenticarse mediante VERCEL_OIDC_TOKEN. AI_GATEWAY_API_KEY
# queda disponible como alternativa explícita para local/otros entornos.
AI_GATEWAY_API_KEY=
AI_COPILOT_MODEL=openai/gpt-5.6-sol

# Seguridad de Development / Preview
# Por defecto las escrituras Supabase quedan BLOQUEADAS fuera del hostname
# canónico de producción. Habilitar únicamente cuando Preview apunte a una
# rama/proyecto Supabase de staging.
ALLOW_NON_PRODUCTION_WRITES=false
NEXT_PUBLIC_ALLOW_NON_PRODUCTION_WRITES=false

# Aun cuando las escrituras Supabase de staging estén habilitadas, el sync
# externo queda bloqueado salvo que apunte a una hoja de prueba.
ALLOW_NON_PRODUCTION_EXTERNAL_SYNC=false
