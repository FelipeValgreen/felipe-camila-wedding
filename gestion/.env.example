# Centro de Gestión — variables de ejemplo
# Nunca guardar valores reales en Git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CRON_SECRET=

# Seguridad de Development / Preview
# Por defecto las escrituras quedan BLOQUEADAS fuera del hostname canónico
# de producción y fuera de VERCEL_ENV=production.
# Habilitar únicamente cuando el entorno apunte a Supabase staging con datos ficticios.
ALLOW_NON_PRODUCTION_WRITES=false
NEXT_PUBLIC_ALLOW_NON_PRODUCTION_WRITES=false

# Aun cuando las escrituras a staging estén habilitadas, el sync externo se
# mantiene bloqueado. Cambiar a true sólo con una Google Sheet de prueba.
ALLOW_NON_PRODUCTION_EXTERNAL_SYNC=false
